{
  "name": "babel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "spike/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && tsc -p apps/web --noEmit --pretty false && tsc -p spike/boardgame-io --noEmit --pretty false",
    "dev": "npm run dev -w @babel-game/web",
    "build": "npm run build -w @babel-game/web",
    "verify": "npm run typecheck && npm test",
    "model": "vite-node packages/harness/src/cli.ts",
    "cadence": "vite-node packages/harness/src/cadence-cli.ts",
    "banks": "vite-node packages/harness/src/banks-cli.ts",
    "sweep": "vite-node packages/harness/src/sweep-cli.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
